{
  "name": "mini-multi",
  "version": "1.0.0",
  "description": "Multiplayer shooter game",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.minimulti.game",
    "productName": "Mini-Multi",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "electronVersion": "28.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}